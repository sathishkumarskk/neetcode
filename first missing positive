class Solution:
    def firstMissingPositive(self, nums: List[int]) -> int:
        nums=[1,2,4]
        nums=[i for i in nums if i>0]
        nums.sort()
        value=0
        if len(nums)!=0:
            for index,min_max in zip(range(len(nums)),range(min(nums),max(nums)+1)):
                if nums[index]!=min_max:
                    value=min_max
                    break
            if value==0:
                return(max(nums)+1)
            else:
                return(value)
        else:
            return(1)
